{% if tools %}
async def {{ name }}(state: AgentState) -> AgentState:
    {{ doc }}
    tools = [{{ tools }}]
    llm = {{ llm }}.bind_tools(tools)
    reply = await run_with_tools(llm, agent_input({{ system_prompt }}, state["messages"]), tools)
    reply.name = "{{ name }}"
    return {"messages": [reply]}
{% else %}
def {{ name }}(state: AgentState) -> AgentState:
    {{ doc }}
    llm = {{ llm }}
    reply = llm.invoke(agent_input({{ system_prompt }}, state["messages"]))
    reply.name = "{{ name }}"
    return {"messages": [reply]}
{% endif %}
